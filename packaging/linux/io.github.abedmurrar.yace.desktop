[Desktop Entry]
Type=Application
Name=YACE
GenericName=Code Editor
Comment=Fast, light, terminal-native multi-root code editor
Exec=yace %f
TryExec=yace
Terminal=true
Icon=io.github.abedmurrar.yace
Categories=Development;TextEditor;IDE;Utility;
Keywords=editor;code;ide;text;programming;vscode;terminal;workspace;
MimeType=text/plain;text/x-csrc;text/x-chdr;text/x-c++src;text/x-python;text/x-rust;text/x-go;text/x-java;text/x-ruby;text/x-shellscript;text/x-makefile;text/markdown;text/html;text/css;application/json;application/x-yaml;application/toml;application/javascript;application/typescript;
StartupNotify=false
